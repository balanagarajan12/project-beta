# Copy to .env in this directory for local Docker Compose (do not commit .env)

# PostgreSQL (etp_iam)
ETP_IAM_DB_PASSWORD=change_me
ETP_IAM_DB_USERNAME=etp_admin
ETP_IAM_DB_PORT=55432

# Keycloak
ETP_IAM_KEYCLOAK_PORT=8180
ETP_IAM_KEYCLOAK_ADMIN_USERNAME=admin
ETP_IAM_KEYCLOAK_ADMIN_PASSWORD=change_me

# pgAdmin (optional)
ETP_IAM_PGADMIN_EMAIL=admin@example.com
ETP_IAM_PGADMIN_PASSWORD=change_me
ETP_IAM_PGADMIN_PORT=5050

# IAM Spring Boot service (when running outside Docker)
ETP_IAM_SERVER_PORT=8081
ETP_IAM_DB_URL=jdbc:postgresql://localhost:55432/etp_iam
ETP_IAM_KEYCLOAK_BASE_URL=http://localhost:8180
ETP_IAM_KEYCLOAK_REALM=etp
ETP_IAM_KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/etp
