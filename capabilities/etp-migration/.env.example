# Copy to .env in this directory for local Docker Compose and Spring Boot.
# Do not commit .env.

# PostgreSQL (etp_migration) — owned by etp-migration compose, not etp-iam.
ETP_MIGRATION_DB_NAME=etp_migration
ETP_MIGRATION_DB_PORT=55433
ETP_MIGRATION_DB_USERNAME=etp_admin
ETP_MIGRATION_DB_PASSWORD=change_me

ETP_MIGRATION_DB_URL=jdbc:postgresql://localhost:55433/etp_migration

ETP_MIGRATION_TARGET_POSTGRESQL_URL=jdbc:postgresql://localhost:55433/etp_migration
ETP_MIGRATION_TARGET_POSTGRESQL_USERNAME=etp_admin
ETP_MIGRATION_TARGET_POSTGRESQL_PASSWORD=change_me
ETP_MIGRATION_TARGET_POSTGRESQL_SCHEMA=migration_staging

# Optional named PostgreSQL profiles. Do not put these values in the migration payload.
# target.connectionRef uam-db is the business database. target.stagingConnectionRef migration-db
# is the database that contains migration_staging. These are different databases.
# ETP_MIGRATION_PG_UAM_URL=jdbc:postgresql://localhost:55432/uam
# ETP_MIGRATION_PG_UAM_USERNAME=etp_admin
# ETP_MIGRATION_PG_UAM_PASSWORD=change_me
# ETP_MIGRATION_PG_STAGING_URL=jdbc:postgresql://localhost:55433/etp_migration
# ETP_MIGRATION_PG_STAGING_USERNAME=etp_admin
# ETP_MIGRATION_PG_STAGING_PASSWORD=change_me
